# ==============================================================================
# Backend Configuration
# ==============================================================================

ENVIRONMENT=development
APP_NAME="Privacy-Preserving AI Code Security Platform"
APP_VERSION=1.0.0
DEBUG=True

HOST=127.0.0.1
PORT=8000
API_PREFIX=/api

# CORS Allowed Origins (Comma-separated for frontend access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# PostgreSQL Connection String
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=code_security_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_security_db

# Privacy Configuration
ANALYSIS_MODE=LOCAL_STATIC_ONLY
ENFORCE_SECRET_REDACTION=True
ALLOW_REMOTE_LLM=False
MAX_SNIPPET_LINE_LIMIT=50
